# ============================================
# PromptHub — Environment Variables
# ============================================
# Copy file ini menjadi .env di masing-masing frontend project.
# Jangan commit file .env asli ke git.

# ── Frontend (boleh publik, dipakai di React/Vite) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ_YOUR_ANON_KEY_HERE

# ── Server-side only (JANGAN di frontend) ──
# Hanya dipakai di Supabase Edge Functions atau backend.
# SUPABASE_SERVICE_ROLE_KEY=eyJ_YOUR_SERVICE_ROLE_KEY
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# JWT_SECRET=your_jwt_secret_here

# ── CATATAN PENTING ──
# - SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, dan JWT_SECRET
#   TIDAK BOLEH ada di kode frontend (.jsx, .js, .ts)
# - Jangan upload file .env asli ke AI coding tool lain
# - Gunakan Supabase Dashboard > Settings > API untuk mendapatkan key
